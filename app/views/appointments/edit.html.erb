    <h2 style="margin: 0; font-size: 1.8rem; font-weight: 600;">Edit Appointment</h2>
    <%= link_to "← Back", appointments_path, class: "btn btn-secondary", style: "padding: 6px 12px; font-size: 14px;" %>
  </div>

  <% content_for :button_text, "Update Appointment" %>
  <%= render "form", appointment: @appointment %>
